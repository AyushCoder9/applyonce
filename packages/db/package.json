{
  "name": "@praman/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "reset": "tsx src/reset.ts && tsx src/migrate.ts && tsx src/seed.ts",
    "studio": "drizzle-kit studio",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@praman/schema": "workspace:*",
    "@praman/crypto": "workspace:*",
    "drizzle-orm": "catalog:",
    "postgres": "catalog:",
    "@praman/providers": "workspace:*"
  },
  "devDependencies": {
    "drizzle-kit": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@types/node": "catalog:"
  }
}